# One file for both apps: copy this to .env.local at the repository root.
# (On Vercel, set the same variables in each project's settings instead.)

# Public URL of the guest invitation app — used to build each guest's personal link.
SITE_URL=http://localhost:3000

# Password for the couple's admin app (required in production).
HOST_PASSWORD=change-me

# Google Sheets — leave empty to run with in-memory demo data.
# 1. Create a Google Cloud service account and enable the Google Sheets API.
# 2. Share your spreadsheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
# 3. The spreadsheet ID is the long part of the URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON, keeping the \n sequences, in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google sign-in for the admin app (optional; replaces the password when set) ---
# OAuth client from Google Cloud Console (APIs & Services > Credentials > OAuth client ID, type "Web application").
# Authorised redirect URI: <admin address>/auth/google/callback, e.g. http://localhost:3001/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google accounts allowed into the admin app, comma separated.
ADMIN_EMAILS=
# Long random string that signs admin sessions (falls back to HOST_PASSWORD).
AUTH_SECRET=

# --- Photo and music uploads (admin app) ---
# Vercel Blob read-write token. Created automatically when a Blob store is connected to the admin project.
BLOB_READ_WRITE_TOKEN=
